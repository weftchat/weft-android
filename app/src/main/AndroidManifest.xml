<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network: needed to reach the user's own relay. Granted at install, never asked (GrapheneOS shows
         it as the "Network" toggle). The brief's asked-for permissions are only camera, microphone and
         notifications, added when needed. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Asked for the first time "Scan their code" is used (BRIEF: camera for QR and photos). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Receiving in the background (BRIEF, Phase 3): notices are asked for once, the first time the
         chat list opens; the foreground service is the "Weft is running" notice (no prompt). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <!-- Lets Weft see whether Orbot is installed (Tor, Phase 3). Nothing else is visible to it. -->
    <queries>
        <package android:name="org.torproject.android" />
        <!-- Tor Browser, offered when a link is tapped. -->
        <package android:name="org.torproject.torbrowser" />
    </queries>
    <application
        android:name=".WeftApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Weft"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <service
            android:name=".WeftService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
